@using PlanningPoker.Hub.Client.Abstractions
@using PlanningPoker.Hub.Client.Abstractions.ViewModels

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Participants</h5>
        <div class="row">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th></th>
                        <th>Name</th>
                        <th>Vote</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var player in Server?.Players?.Where(p => p.Type == PlayerType.Participant).OrderBy(p => p.PublicId) ?? Enumerable.Empty<PlayerViewModel>())
                {
                    var hasVoted = Server?.CurrentSession?.Votes?.ContainsKey(player.PublicId.ToString()) ?? false;
                    var isAsleep = player.Mode == PlayerMode.Asleep;
                    var currentPlayerVote = hasVoted ? Server.CurrentSession.Votes[player.PublicId.ToString()] : string.Empty;
                    var hasQuestion = HasQuestion(currentPlayerVote);
                    <tr class="@(hasQuestion ? "has-question" : hasVoted ? "table-success" : "") @(isAsleep ? "asleep" : "")">
                        <td>
                            @if (hasQuestion)
                            {
                                <span class="oi oi-question-mark" title="Has questions"></span>
                            }
                            else if (hasVoted && !isAsleep)
                            {
                                <span class="oi oi-check"></span>
                            }
                            @if (isAsleep)
                            {
                                <span class="oi oi-moon"></span>
                            }
                        </td>
                        <td>
                            @player.Name
                        </td>
                        <td>
                            @currentPlayerVote
                        </td>
                        <td class="action-cell">
                            @SleepButton(player)
                        </td>
                        <td class="action-cell">
                            @if (CurrentPlayer.PublicId == player.PublicId)
                            {
                                <button class="changetype-btn btn float-right" @onclick="() => ChangeType(PlayerType.Observer)" disabled="@PlayerHasVoted()">
                                    <span class="changetype-icon oi oi-loop"></span>
                                </button>
                            }
                        </td>
                        <td class="action-cell">
                            <button class="admin-btn btn float-right @(player.IsAdmin ? "is-admin" : "")" @onclick="() => ToggleAdmin(player)" disabled="@(!CanControl)" title="@(player.IsAdmin ? "Admin" : "Make admin")">
                                <span class="oi oi-star"></span>
                            </button>
                        </td>
                        <td class="action-cell">
                            @if (CanControl)
                            {
                                <button class="kick-btn btn float-right" @onclick="() => Kick(player.PublicId)">
                                    <span class="kick-icon oi oi-x"></span>
                                </button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Observers</h5>
        <div class="row">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var player in Server?.Players?.Where(p => p.Type == PlayerType.Observer).OrderBy(p => p.PublicId) ?? Enumerable.Empty<PlayerViewModel>())
                {
                    var isAsleep = player.Mode == PlayerMode.Asleep;
                    <tr class="@(isAsleep ? "asleep" : "")">
                        <td>
                            @player.Name
                        </td>
                        <td class="action-cell">
                            @SleepButton(player)
                        </td>
                        <td class="action-cell">
                            @if (CurrentPlayer.PublicId == player.PublicId)
                            {
                                <button class="changetype-btn btn float-right" @onclick="() => ChangeType(PlayerType.Participant)" disabled="@PlayerHasVoted()">
                                    <span class="changetype-icon oi oi-loop"></span>
                                </button>
                            }
                        </td>
                        <td class="action-cell">
                            <button class="admin-btn btn float-right @(player.IsAdmin ? "is-admin" : "")" @onclick="() => ToggleAdmin(player)" disabled="@(!CanControl)" title="@(player.IsAdmin ? "Admin" : "Make admin")">
                                <span class="oi oi-star"></span>
                            </button>
                        </td>
                        <td class="action-cell">
                            @if (CanControl)
                            {
                                <button class="kick-btn btn float-right" @onclick="() => Kick(player.PublicId)">
                                    <span class="kick-icon oi oi-x"></span>
                                </button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public EventCallback<Guid> IdChanged { get; set; }

    [Parameter]
    public IPlanningPokerHubClient HubClient { get; set; }

    [Parameter]
    public EventCallback<IPlanningPokerHubClient> HubClientChanged { get; set; }

    [Parameter]
    public PlayerViewModel CurrentPlayer { get; set; }

    [Parameter]
    public EventCallback<PlayerViewModel> CurrentPlayerChanged { get; set; }

    [Parameter]
    public PokerServerViewModel Server { get; set; }

    [Parameter]
    public EventCallback<PokerServerViewModel> ServerChanged { get; set; }

    [Parameter]
    public bool CanControl { get; set; }

    private const string QuestionCard = "?";

    RenderFragment SleepButton(PlayerViewModel player) => __builder =>
    {
        var isSelf = CurrentPlayer.PublicId == player.PublicId;
        var isAsleep = player.Mode == PlayerMode.Asleep;
        if (isSelf)
        {
            <button class="sleep-btn btn float-right @(isAsleep ? "is-asleep" : "")" @onclick="() => SetSleep(player, !isAsleep)" title="@(isAsleep ? "I'm back" : "Take a break")">
                <span class="oi @(isAsleep ? "oi-sun" : "oi-moon")"></span>
            </button>
        }
        else if (CanControl && !isAsleep)
        {
            <button class="sleep-btn btn float-right" @onclick="() => SetSleep(player, true)" title="Put to sleep">
                <span class="oi oi-moon"></span>
            </button>
        }
    };

    // Before votes are shown, every vote is masked as "?", so only a revealed "?" means the player has questions.
    bool HasQuestion(string vote)
    {
        return Server?.CurrentSession?.IsShown == true && vote == QuestionCard;
    }

    Task SetSleep(PlayerViewModel player, bool asleep)
    {
        return HubClient.SetSleep(Id, player.PublicId, asleep);
    }

    Task ToggleAdmin(PlayerViewModel player)
    {
        return HubClient.SetAdmin(Id, player.PublicId, !player.IsAdmin);
    }

    Task Kick(int playerPublicId)
    {
        return HubClient.KickPlayer(Id, CurrentPlayer.Id, playerPublicId);
    }

    async Task ChangeType(PlayerType newType)
    {
        var updatedPlayer = await HubClient.ChangePlayerType(Id, newType);
        await CurrentPlayerChanged.InvokeAsync(updatedPlayer);
    }

    bool PlayerHasVoted()
    {
        return Server.CurrentSession.Votes.Any(v => v.Key == CurrentPlayer.PublicId.ToString());
    }
}