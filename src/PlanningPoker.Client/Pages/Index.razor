@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Options
@using PlanningPoker.Client.Configuration
@using PlanningPoker.Client.Utilities
@using PlanningPoker.Hub.Client
@using PlanningPoker.Hub.Client.Abstractions
@using PlanningPoker.Hub.Client.Abstractions.ViewModels
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IOptions<NextEnvironmentConfiguration> NextEnvironmentConfiguration
@inject PlanningPoker.Client.Storage.IUserPreferencesManager UserPreferencesManager

@if (string.IsNullOrWhiteSpace(CreatedServerAddress))
{
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <h2>Welcome to Just Planning Poker!</h2> 
                    <p>This is just a planning poker tool. No sign-up, no gathered user data, no fees.</p>
                    <p>Pick a card set below, or make your own. Type a card and press space, comma or enter to add it.</p>
                    <div class="form-group">
                        <label for="cardPreset">Preset</label>
                        <select id="cardPreset" class="custom-select card-preset" value="@SelectedPreset()" @onchange="SelectPreset">
                            @foreach (var preset in Cards.Presets.Keys)
                            {
                                <option value="@preset">@preset</option>
                            }
                            <option value="" disabled>Custom</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="cardInput">Card set</label>
                        <div class="form-control card-set-input" @onclick="FocusCardInput">
                            @foreach (var card in _cards)
                            {
                                <span class="card-chip">
                                    @card
                                    <button type="button" class="card-chip-remove" title="Remove @card" @onclick="() => RemoveCard(card)" @onclick:stopPropagation="true">&times;</button>
                                </span>
                            }
                            <input id="cardInput"
                                   @ref="_cardInput"
                                   @bind-value:get="_newCard"
                                   @bind-value:set="OnCardInput"
                                   @bind-value:event="oninput"
                                   @onkeydown="OnCardKeyDown"
                                   placeholder="@(_cards.Any() ? "" : "Add a card...")"
                                   class="card-input" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_cardValidationMessage))
                        {
                            <small class="text-danger">@_cardValidationMessage</small>
                        }
                        @if (_creationResult != null && !string.IsNullOrWhiteSpace(_creationResult.ValidationMessage))
                        {
                            <small class="text-danger">
                                @_creationResult.ValidationMessage
                            </small>
                        }
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <p>Press below to create a room for you. This will create a link, where you and your participants can create a user and start voting.</p>
                    <p>Happy planning!</p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <button @onclick="Create" disabled="@(HasCreated || (!_cards.Any() && string.IsNullOrWhiteSpace(_newCard)))" class="btn btn-primary">Create room</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @if (NextEnvironmentConfiguration?.Value != null && !string.IsNullOrWhiteSpace(NextEnvironmentConfiguration.Value.RichText))
    {
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col">
                        <p>@((MarkupString)NextEnvironmentConfiguration.Value.RichText)</p>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col">
                    <p>Your room has been created. Click to join!</p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <a href="@CreatedServerAddress" class="btn btn-primary">Join room</a>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <p>Below is the link to your room. Send this to your participants, and start planning!</p>
                    <div class="input-group mb-3">
                        <input class="form-control" value="@CreatedServerAddress" disabled="disabled" />
                        <div class="input-group-append">
                            <button @onclick="CopyToClipboard" class="btn btn-outline-secondary" type="button" id="button-addon2">Copy</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

@code {
    private IPlanningPokerHubClient _hubClient;

    private List<string> _cards = new List<string>();

    private string _newCard = string.Empty;

    private string? _cardValidationMessage;

    private ElementReference _cardInput;

    private static readonly char[] CardSeparators = { ',', ' ', ';' };

    private ServerCreationResult _creationResult;

    protected override async Task OnInitializedAsync()
    {
        var lastCardSet = UserPreferencesManager.GetLastCardSet();
        _cards = string.IsNullOrWhiteSpace(lastCardSet)
            ? Cards.DefaultCardSet.ToList()
            : lastCardSet.Split(',').Where(c => !string.IsNullOrWhiteSpace(c)).ToList();
        var connection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/poker"))
            .WithAutomaticReconnect()
            .Build();
        await connection.StartAsync();
        _hubClient = new PlanningPokerHubClient(connection);
    }

    string SelectedPreset()
    {
        return Cards.Presets.FirstOrDefault(preset => preset.Value.SequenceEqual(_cards)).Key ?? string.Empty;
    }

    void SelectPreset(ChangeEventArgs e)
    {
        if (e.Value is string preset && Cards.Presets.TryGetValue(preset, out var cards))
        {
            _cards = cards.ToList();
            _cardValidationMessage = null;
        }
    }

    async Task FocusCardInput()
    {
        await _cardInput.FocusAsync();
    }

    void OnCardInput(string? value)
    {
        value ??= string.Empty;
        if (value.IndexOfAny(CardSeparators) < 0)
        {
            _newCard = value;
            return;
        }

        var parts = value.Split(CardSeparators);
        foreach (var part in parts.Take(parts.Length - 1))
        {
            AddCard(part);
        }

        _newCard = parts.Last();
    }

    void OnCardKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddCard(_newCard);
            _newCard = string.Empty;
        }
        else if (e.Key == "Backspace" && string.IsNullOrEmpty(_newCard) && _cards.Any())
        {
            _cards.RemoveAt(_cards.Count - 1);
        }
    }

    void AddCard(string card)
    {
        card = card.Trim();
        if (card.Length == 0) return;

        if (!Cards.IsValidCard(card))
        {
            _cardValidationMessage = $"'{card}' is not a valid card. Cards must be whole numbers, or at most 3 characters.";
            return;
        }

        _cardValidationMessage = null;
        if (!_cards.Contains(card))
        {
            _cards.Add(card);
        }
    }

    void RemoveCard(string card)
    {
        _cards.Remove(card);
    }

    async Task Create()
    {
        AddCard(_newCard);
        _newCard = string.Empty;
        var cardSet = string.Join(",", _cards);
        var creationResult = await _hubClient.CreateServer(cardSet);
        _creationResult = creationResult;
        if (_creationResult.Created)
        {
            UserPreferencesManager.SetLastCardSet(cardSet);
            var uri = NavigationManager.ToAbsoluteUri($"/server/{_creationResult.ServerId}");
            CreatedServerAddress = uri.AbsoluteUri;
            HasCreated = true;
        }

        StateHasChanged();
    }

    async Task CopyToClipboard()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", CreatedServerAddress);
    }

    public string? CreatedServerAddress { get; set; }

    public bool HasCreated = false;
}